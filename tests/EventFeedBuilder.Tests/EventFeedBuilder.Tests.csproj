<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="coverlet.collector" Version="6.0.4" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.14.1" />
    <PackageReference Include="xunit" Version="2.9.3" />
    <PackageReference Include="xunit.runner.visualstudio" Version="3.1.4" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="Xunit" />
  </ItemGroup>

  <ItemGroup>
    <!-- Saved supercars.com pages (see docs/spikes/S1). Refresh them when the site changes. -->
    <None Include="Fixtures\**" CopyToOutputDirectory="PreserveNewest" />
    <None Include="..\..\feed\*.json" Link="feed\%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\tools\EventFeedBuilder\EventFeedBuilder.csproj" />
    <ProjectReference Include="..\..\src\RaceCountdown.Core\RaceCountdown.Core.csproj" />
  </ItemGroup>

</Project>