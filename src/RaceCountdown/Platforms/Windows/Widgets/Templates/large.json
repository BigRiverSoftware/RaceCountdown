{
  "type": "AdaptiveCard",
  "$schema": "http://adaptivecards.io/schemas/adaptive-card.json",
  "version": "1.5",
  "backgroundImage": {
    "url": "${background}",
    "fillMode": "cover",
    "horizontalAlignment": "center",
    "verticalAlignment": "bottom"
  },
  "verticalContentAlignment": "Center",
  "selectAction": {
    "type": "Action.Execute",
    "verb": "open",
    "tooltip": "Open Bathurst Countdown"
  },
  "body": [
    {
      "type": "TextBlock",
      "text": "${title}",
      "size": "Large",
      "weight": "Bolder",
      "color": "Light",
      "horizontalAlignment": "Center",
      "wrap": true
    },
    {
      "type": "ColumnSet",
      "$when": "${showSegments}",
      "horizontalAlignment": "Center",
      "spacing": "Large",
      "columns": [
        {
          "type": "Column",
          "width": "auto",
          "items": [
            { "type": "TextBlock", "text": "${days}", "size": "ExtraLarge", "weight": "Bolder", "color": "Light", "horizontalAlignment": "Center" },
            { "type": "TextBlock", "text": "DAYS", "size": "Default", "weight": "Bolder", "color": "Light", "isSubtle": true, "horizontalAlignment": "Center", "spacing": "None" }
          ]
        },
        {
          "type": "Column",
          "width": "auto",
          "spacing": "ExtraLarge",
          "items": [
            { "type": "TextBlock", "text": "${hours}", "size": "ExtraLarge", "weight": "Bolder", "color": "Light", "horizontalAlignment": "Center" },
            { "type": "TextBlock", "text": "HRS", "size": "Default", "weight": "Bolder", "color": "Light", "isSubtle": true, "horizontalAlignment": "Center", "spacing": "None" }
          ]
        },
        {
          "type": "Column",
          "width": "auto",
          "spacing": "ExtraLarge",
          "items": [
            { "type": "TextBlock", "text": "${minutes}", "size": "ExtraLarge", "weight": "Bolder", "color": "Light", "horizontalAlignment": "Center" },
            { "type": "TextBlock", "text": "MIN", "size": "Default", "weight": "Bolder", "color": "Light", "isSubtle": true, "horizontalAlignment": "Center", "spacing": "None" }
          ]
        }
      ]
    },
    {
      "type": "TextBlock",
      "$when": "${!showSegments}",
      "text": "${headline}",
      "size": "ExtraLarge",
      "weight": "Bolder",
      "color": "Light",
      "horizontalAlignment": "Center",
      "spacing": "Large"
    },
    {
      "type": "TextBlock",
      "$when": "${!showSegments}",
      "text": "${detail}",
      "size": "Large",
      "color": "Light",
      "horizontalAlignment": "Center",
      "spacing": "Small",
      "wrap": true
    },
    {
      "type": "TextBlock",
      "$when": "${isStale}",
      "text": "${staleText}",
      "size": "Small",
      "color": "Light",
      "isSubtle": true,
      "horizontalAlignment": "Center",
      "wrap": true
    }
  ]
}
