{
  "type": "AdaptiveCard",
  "$schema": "http://adaptivecards.io/schemas/adaptive-card.json",
  "version": "1.5",
  "backgroundImage": { "url": "${background}", "fillMode": "cover", "horizontalAlignment": "center", "verticalAlignment": "center" },
  "verticalContentAlignment": "Center",
  "selectAction": { "type": "Action.Execute", "verb": "open", "tooltip": "Open Bathurst Countdown" },
  "body": [
    {
      "type": "TextBlock",
      "text": "${title}",
      "size": "Medium",
      "weight": "Bolder",
      "color": "Light",
      "horizontalAlignment": "Center",
      "wrap": true,
      "maxLines": 2
    },
    {
      "type": "TextBlock",
      "text": "${headline}",
      "size": "ExtraLarge",
      "weight": "Bolder",
      "color": "Light",
      "horizontalAlignment": "Center",
      "spacing": "Small"
    },
    {
      "type": "TextBlock",
      "text": "${detail}",
      "size": "Medium",
      "color": "Light",
      "horizontalAlignment": "Center",
      "spacing": "None",
      "wrap": true
    },
    {
      "type": "TextBlock",
      "$when": "${isStale}",
      "text": "${staleText}",
      "size": "Small",
      "color": "Light",
      "isSubtle": true,
      "horizontalAlignment": "Center",
      "wrap": true
    }
  ]
}
