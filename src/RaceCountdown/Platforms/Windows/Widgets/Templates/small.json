{
  "type": "AdaptiveCard",
  "$schema": "http://adaptivecards.io/schemas/adaptive-card.json",
  "version": "1.5",
  "backgroundImage": { "url": "${background}", "fillMode": "cover", "horizontalAlignment": "center", "verticalAlignment": "center" },
  "verticalContentAlignment": "Center",
  "selectAction": { "type": "Action.Execute", "verb": "open", "tooltip": "Open Bathurst Countdown" },
  "body": [
    {
      "type": "ColumnSet",
      "$when": "${showSegments}",
      "horizontalAlignment": "Center",
      "columns": [
        {
          "type": "Column",
          "width": "auto",
          "items": [
            { "type": "TextBlock", "text": "${days}", "size": "Large", "weight": "Bolder", "color": "Light", "horizontalAlignment": "Center" },
            { "type": "TextBlock", "text": "DAYS", "size": "Small", "weight": "Bolder", "color": "Light", "isSubtle": true, "horizontalAlignment": "Center", "spacing": "None" }
          ]
        },
        {
          "type": "Column",
          "width": "auto",
          "spacing": "Medium",
          "items": [
            { "type": "TextBlock", "text": "${hours}", "size": "Large", "weight": "Bolder", "color": "Light", "horizontalAlignment": "Center" },
            { "type": "TextBlock", "text": "HRS", "size": "Small", "weight": "Bolder", "color": "Light", "isSubtle": true, "horizontalAlignment": "Center", "spacing": "None" }
          ]
        },
        {
          "type": "Column",
          "width": "auto",
          "spacing": "Medium",
          "items": [
            { "type": "TextBlock", "text": "${minutes}", "size": "Large", "weight": "Bolder", "color": "Light", "horizontalAlignment": "Center" },
            { "type": "TextBlock", "text": "MIN", "size": "Small", "weight": "Bolder", "color": "Light", "isSubtle": true, "horizontalAlignment": "Center", "spacing": "None" }
          ]
        }
      ]
    },
    {
      "type": "TextBlock",
      "$when": "${!showSegments}",
      "text": "${compactHeadline}",
      "size": "ExtraLarge",
      "weight": "Bolder",
      "color": "Light",
      "horizontalAlignment": "Center",
      "fontType": "Default"
    },
    {
      "type": "TextBlock",
      "$when": "${!showSegments}",
      "text": "${compactCaption}",
      "size": "Small",
      "weight": "Bolder",
      "color": "Light",
      "horizontalAlignment": "Center",
      "spacing": "None",
      "wrap": true
    },
    {
      "type": "TextBlock",
      "$when": "${isStale}",
      "text": "Offline",
      "size": "Small",
      "color": "Light",
      "isSubtle": true,
      "horizontalAlignment": "Center"
    }
  ]
}
