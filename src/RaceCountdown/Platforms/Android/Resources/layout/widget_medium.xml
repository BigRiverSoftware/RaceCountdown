<?xml version="1.0" encoding="utf-8"?>
<!-- Medium (4×2) countdown widget: title, headline or race-day chronometer, detail line (plan §8.2). -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/widget_frame"
    android:clipToOutline="true">

    <ImageView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:importantForAccessibility="no"
        android:scaleType="centerCrop"
        android:src="@drawable/widget_background" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:gravity="center_vertical|start"
        android:orientation="vertical"
        android:paddingStart="16dp"
        android:paddingEnd="16dp">

        <TextView
            android:id="@+id/widget_title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:ellipsize="end"
            android:fontFamily="sans-serif-medium"
            android:maxLines="1"
            android:textColor="#FFFFFF"
            android:textSize="14sp" />

        <TextView
            android:id="@+id/widget_headline"
            android:layout_width="match_parent"
            android:layout_height="44dp"
            android:autoSizeMaxTextSize="34sp"
            android:autoSizeMinTextSize="16sp"
            android:autoSizeTextType="uniform"
            android:fontFamily="sans-serif-medium"
            android:maxLines="1"
            android:textColor="#FFFFFF"
            android:textSize="34sp" />

        <Chronometer
            android:id="@+id/widget_chronometer"
            android:layout_width="match_parent"
            android:layout_height="44dp"
            android:autoSizeMaxTextSize="34sp"
            android:autoSizeMinTextSize="16sp"
            android:autoSizeTextType="uniform"
            android:fontFamily="sans-serif-medium"
            android:textColor="#FFFFFF"
            android:textSize="34sp"
            android:visibility="gone" />

        <TextView
            android:id="@+id/widget_detail"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:letterSpacing="0.05"
            android:maxLines="1"
            android:textColor="#FFC21A"
            android:textSize="14sp" />

        <TextView
            android:id="@+id/widget_stale"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/widget_offline"
            android:textColor="#E6FFFFFF"
            android:textSize="11sp"
            android:visibility="gone" />
    </LinearLayout>
</FrameLayout>
