<?xml version="1.0" encoding="UTF-8" ?>
<Shell
    x:Class="RaceCountdown.AppShell"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:views="clr-namespace:RaceCountdown.Views"
    Title="Bathurst Countdown"
    Shell.FlyoutBehavior="Disabled">

    <!-- v1 has one page. EventListPage and SettingsPage can be added here later (plan §7). -->
    <ShellContent
        Title="Countdown"
        ContentTemplate="{DataTemplate views:CountdownPage}"
        Route="Countdown" />

</Shell>
