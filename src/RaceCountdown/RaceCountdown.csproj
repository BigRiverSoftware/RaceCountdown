<Project Sdk="Microsoft.NET.Sdk">

	<PropertyGroup>
		<!-- Android and Windows only (plan D1). The Windows target can only be built on Windows. -->
		<TargetFrameworks>net10.0-android</TargetFrameworks>
		<TargetFrameworks Condition="$([MSBuild]::IsOSPlatform('windows'))">$(TargetFrameworks);net10.0-windows10.0.19041.0</TargetFrameworks>

		<OutputType>Exe</OutputType>
		<RootNamespace>RaceCountdown</RootNamespace>
		<UseMaui>true</UseMaui>
		<SingleProject>true</SingleProject>
		<ImplicitUsings>enable</ImplicitUsings>
		<Nullable>enable</Nullable>

		<!-- Enable XAML source generation for faster build times and improved performance.
		     This generates C# code from XAML at compile time instead of runtime inflation.
		     To disable, remove this line.
		     For individual files, you can override by setting Inflator metadata:
		       <MauiXaml Update="MyPage.xaml" Inflator="Default" /> (reverts to defaults: Runtime for Debug, XamlC for Release)
		       <MauiXaml Update="MyPage.xaml" Inflator="Runtime" /> (force runtime inflation) -->
		<MauiXamlInflator>SourceGen</MauiXamlInflator>

		<!-- Display name -->
		<ApplicationTitle>Bathurst Countdown</ApplicationTitle>

		<!-- App Identifier (plan D10). Never change this after the first release. -->
		<ApplicationId>au.bigriversoftware.bathurstcountdown</ApplicationId>

		<!-- Versions -->
		<ApplicationDisplayVersion>0.1.0</ApplicationDisplayVersion>
		<ApplicationVersion>1</ApplicationVersion>
		<!-- The Windows packaging SDK defaults PackageVersion to 1.0.0, which conflicts with Android's
		     (derived from ApplicationDisplayVersion) when VS evaluates both TFMs together. Pin it explicitly. -->
		<PackageVersion>1.0.8.0</PackageVersion>

		<!-- Packaged (MSIX) so the app can register as a Windows 11 widget provider (plan D4). -->
		<WindowsPackageType>MSIX</WindowsPackageType>

		<SupportedOSPlatformVersion Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'android'">26.0</SupportedOSPlatformVersion>
		<SupportedOSPlatformVersion Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'windows'">10.0.17763.0</SupportedOSPlatformVersion>
		<TargetPlatformMinVersion Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'windows'">10.0.17763.0</TargetPlatformMinVersion>
	</PropertyGroup>

	<ItemGroup>
		<!-- App Icon (docs/design-system): the stopwatch master over its own dark rounded frame. The master is a PNG
		     because its text is Poppins. Android shrinks it into the adaptive icon's safe zone; Windows shows it whole. -->
		<MauiIcon Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'android'"
		          Include="Resources\AppIcon\appicon.svg" ForegroundFile="Resources\AppIcon\appiconfg.png" ForegroundScale="0.66" />
		<MauiIcon Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) != 'android'"
		          Include="Resources\AppIcon\appicon.svg" ForegroundFile="Resources\AppIcon\appiconfg.png" />

		<!-- Splash Screen: the white Mount Panorama circuit on dial-navy -->
		<MauiSplashScreen Include="Resources\Splash\splash.svg" Color="#143A7A" BaseSize="128,128" />

		<!-- Images -->
		<MauiImage Include="Resources\Images\*" />
		<!-- Full-screen art (docs/backgrounds, copied by tools/dev/build_art.py): base sizes make the 4x
		     (xxxhdpi / scale-400) PNGs the size of the 1080 × 1920 masters. -->
		<MauiImage Update="Resources\Images\background_portrait.png" BaseSize="270,480" />
		<MauiImage Update="Resources\Images\background_landscape.png" BaseSize="480,270" />
		<MauiImage Update="Resources\Images\widget_background.png" BaseSize="320,160" />

		<!-- Custom Fonts -->
		<MauiFont Include="Resources\Fonts\*" />

		<!-- Raw Assets (also remove the "Resources\Raw" prefix) -->
		<MauiAsset Include="Resources\Raw\**" LogicalName="%(RecursiveDir)%(Filename)%(Extension)" />
	</ItemGroup>

	<ItemGroup>
		<PackageReference Include="CommunityToolkit.Mvvm" Version="8.4.2" />
		<PackageReference Include="Microsoft.Extensions.Http" Version="10.0.12" />
		<PackageReference Include="Microsoft.Maui.Controls" Version="$(MauiVersion)" />
		<PackageReference Include="Microsoft.Extensions.Logging.Debug" Version="10.0.0" />
	</ItemGroup>

	<ItemGroup Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'android'">
		<!-- Background feed refresh for the home-screen widget (plan §8.2). 2.10.3 uses the same AndroidX Lifecycle (2.9.2) as MAUI; 2.11 does not. -->
		<PackageReference Include="Xamarin.AndroidX.Work.Runtime" Version="2.10.3" />
	</ItemGroup>

	<!-- Android Release signing with the local keystore in the repo root (gitignored, so only present on machines that have it).
	     Passwords come from the gitignored android-signing.props in the repo root (copy android-signing.props.example),
	     otherwise from the ANDROID_KEYSTORE_PASSWORD environment variable. Never store them here.
	     The keystore is PKCS12, which protects the key with the store password, so that is the key password too.
	     CI (release.yml) passes its own AndroidSigning* properties on the command line, which take precedence. -->
	<Import Project="$(MSBuildThisFileDirectory)..\..\android-signing.props" Condition="Exists('$(MSBuildThisFileDirectory)..\..\android-signing.props')" />
	<PropertyGroup Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'android' and '$(Configuration)' == 'Release' and '$(AndroidSigningKeyStore)' == '' and Exists('$(MSBuildThisFileDirectory)..\..\brs.jks')">
		<AndroidKeyStore>true</AndroidKeyStore>
		<AndroidSigningKeyStore>$(MSBuildThisFileDirectory)..\..\brs.jks</AndroidSigningKeyStore>
		<AndroidSigningStorePass Condition="'$(AndroidSigningStorePass)' == ''">env:ANDROID_KEYSTORE_PASSWORD</AndroidSigningStorePass>
		<AndroidSigningKeyAlias>brsapp</AndroidSigningKeyAlias>
		<AndroidSigningKeyPass Condition="'$(AndroidSigningKeyPass)' == ''">env:ANDROID_KEYSTORE_PASSWORD</AndroidSigningKeyPass>
	</PropertyGroup>

	<!-- Windows widget provider (plan §8.3, D5): a custom Main that can start as a COM server instead of the UI,
	     source-generated COM for the class factory, and the Adaptive Card templates. -->
	<PropertyGroup Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'windows'">
		<DefineConstants>$(DefineConstants);DISABLE_XAML_GENERATED_MAIN</DefineConstants>
		<AllowUnsafeBlocks>true</AllowUnsafeBlocks>
	</PropertyGroup>

	<ItemGroup Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'windows'">
		<EmbeddedResource Include="Platforms\Windows\Widgets\Templates\*.json" LogicalName="RaceCountdown.Widgets.Templates.%(Filename)%(Extension)" />
	</ItemGroup>

	<ItemGroup>
		<ProjectReference Include="..\RaceCountdown.Core\RaceCountdown.Core.csproj" />
	</ItemGroup>

</Project>
